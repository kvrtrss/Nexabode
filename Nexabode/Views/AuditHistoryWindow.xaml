<Window x:Class="Nexabode.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="1100" Height="680" MinWidth="800" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox x:Name="SearchBox" Width="300" PlaceholderText="Search the history"
                        TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="CategoryBox" Width="160" Margin="10,0,0,0" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="Show only this kind of change" />
            <CheckBox x:Name="TechCheck" Content="Technical view" Margin="14,0,0,0" VerticalAlignment="Center"
                      Checked="Technical_Changed" Unchecked="Technical_Changed"
                      ToolTip="Show every stored record in a table, with the raw field names and values" />
            <TextBlock x:Name="CountText" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <!-- The readable timeline: one card for each action, grouped by day -->
        <ScrollViewer Grid.Row="2" x:Name="CardScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CardPanel" Margin="0,0,12,0" />
        </ScrollViewer>

        <!-- Every stored record, as it was saved -->
        <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" Visibility="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130" />
                <DataGridTextColumn Header="By" Binding="{Binding Administrator}" Width="90" />
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="140" />
                <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="90" />
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="190" />
                <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="170" />
                <DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="170" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                <DataGridTextColumn Header="Exception" Binding="{Binding Exception}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
