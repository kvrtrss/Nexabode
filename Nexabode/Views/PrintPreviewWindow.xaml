<Window x:Class="Nexabode.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Title="Print" Width="1020" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- One print window: the page on the left, the printer settings and the Print button on the right.
         Nothing else opens, so there is no separate Windows print window without a preview. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- The page as it will print, one page at a time, with zoom and page arrows from the viewer itself.
             Printing is done by the button on the right, so the viewer's own print button is switched off. -->
        <FlowDocumentReader x:Name="Reader" Grid.Column="0" Margin="12"
                            ViewingMode="Page" IsScrollViewEnabled="False" IsTwoPageViewEnabled="False"
                            IsPrintEnabled="False" IsFindEnabled="False" />

        <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="18"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock x:Name="PagesText" Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                        <TextBlock Text="Printer" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="PrinterCombo" DisplayMemberPath="FullName" HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4" SelectionChanged="Settings_Changed"
                                  AutomationProperties.Name="Printer" />
                        <TextBlock x:Name="PrinterNote" Style="{StaticResource MutedText}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="Copies" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="CopiesBox" Text="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,12"
                                    AutomationProperties.Name="Copies" />

                        <TextBlock Text="Orientation" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                  SelectionChanged="Settings_Changed" AutomationProperties.Name="Orientation">
                            <ComboBoxItem Content="Portrait" />
                            <ComboBoxItem Content="Landscape" />
                        </ComboBox>

                        <TextBlock x:Name="PaperText" Style="{StaticResource MutedText}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                   Text="To save a file instead of printing on paper, choose Microsoft Print to PDF as the printer." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                        <ui:Button x:Name="PrintButton" Content="Print" Appearance="Primary" IsDefault="True"
                                   MinWidth="110" Click="Print_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
