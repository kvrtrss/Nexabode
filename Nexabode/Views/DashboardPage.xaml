<Page x:Class="Nexabode.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,20,30,20">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" />
            <TextBlock x:Name="DateText" Opacity="0.7" Margin="0,2,0,24" />

            <UniformGrid Columns="4">
                <ui:Card Margin="0,0,12,0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Occupied beds" Opacity="0.7" />
                        <TextBlock x:Name="OccupiedText" FontSize="34" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,12,0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Vacant beds" Opacity="0.7" />
                        <TextBlock x:Name="VacantText" FontSize="34" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,12,0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Collected this month" Opacity="0.7" />
                        <TextBlock x:Name="CollectedText" FontSize="34" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>

                <ui:Card HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Overdue balance" Opacity="0.7" />
                        <TextBlock x:Name="OverdueText" FontSize="34" FontWeight="Bold"
                                   Foreground="IndianRed" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>