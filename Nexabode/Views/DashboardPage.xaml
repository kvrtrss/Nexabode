<Page x:Class="Nexabode.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Dashboard">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto" Background="Transparent">
        <Border Padding="32,24" MinWidth="880"
                Width="{Binding ViewportWidth, ElementName=PageScroll}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <controls:PageHeader x:Name="Header" Title="Dashboard"
                         ActionText="Add tenant" ActionClick="AddTenant_Click" />

                <!-- One reminder for everything still to do. Colored as a warning while setup is unfinished. -->
                <Border x:Name="SetupCard" Visibility="Collapsed" Margin="0,0,0,16" Padding="18,14"
                        CornerRadius="8" BorderThickness="3,0,0,0"
                        Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}">
                    <Border.Resources>
                        <!-- The reminder's buttons take the card's own color (amber while setup is unfinished, blue for tips),
                             so they sit naturally on the tint instead of fighting it. SetupAccent is set in code. -->
                        <SolidColorBrush x:Key="SetupAccent" Color="#B45309" />

                        <Style x:Key="SetupSolidButton" TargetType="ui:Button">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="16,7" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ui:Button">
                                        <Grid>
                                            <Border x:Name="Fill" CornerRadius="6" Background="{DynamicResource SetupAccent}" />
                                            <Border x:Name="Shade" CornerRadius="6" Background="#26000000" Visibility="Collapsed" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SetupQuietButton" TargetType="ui:Button">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                            <Setter Property="Padding" Value="16,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ui:Button">
                                        <Grid>
                                            <Border x:Name="Fill" CornerRadius="6" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SetupAccent}" Background="Transparent" />
                                            <Border x:Name="Shade" CornerRadius="6" Background="{DynamicResource SetupAccent}"
                                                    Opacity="0.14" Visibility="Collapsed" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="SetupIcon" Symbol="ShieldError24" FontSize="28" VerticalAlignment="Top"
                                       Margin="0,2,14,0" Foreground="{DynamicResource WarningBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SetupTitle" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock x:Name="SetupSubtitle" TextWrapping="Wrap" Margin="0,2,0,6"
                                       Foreground="{DynamicResource AppTextBrush}" />
                            <StackPanel x:Name="SetupRows" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="SetupPrimary" Style="{StaticResource SetupSolidButton}"
                                       HorizontalAlignment="Stretch" Click="SetupPrimary_Click" />
                            <ui:Button x:Name="SetupSecondary" Style="{StaticResource SetupQuietButton}"
                                       Visibility="Collapsed" Margin="0,6,0,0"
                                       HorizontalAlignment="Stretch" Click="SetupSecondary_Click" />
                            <ui:Button Content="Remind me later" Style="{StaticResource SetupQuietButton}"
                                       Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="HideSetup_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Stat cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <controls:StatCard x:Name="OccupancyCard" Label="Occupancy" Margin="0,0,12,0" />
                <controls:StatCard x:Name="BedsCard" Label="Occupied beds" Margin="0,0,12,0" />
                <controls:StatCard x:Name="CollectedCard" Label="Collected this month" Margin="0,0,12,0" />
                <controls:StatCard x:Name="OutstandingCard" Label="Outstanding" />
            </UniformGrid>

            <!-- Quick actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Quick actions" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Content="Record payment" Click="RecordPayment_Click" Margin="0,0,8,0" />
                <ui:Button Content="Generate rent" Click="GenerateRent_Click" Margin="0,0,8,0" />
                <ui:Button Content="Add utility bill" Click="AddUtility_Click" />
            </StackPanel>

            <!-- Calendar and activity -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="MonthTitle" Style="{StaticResource SectionTitle}"
                                       FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="‹" Appearance="Transparent" Click="PrevMonth_Click" />
                                <ui:Button Content="Today" Appearance="Transparent" Click="Today_Click" />
                                <ui:Button Content="›" Appearance="Transparent" Click="NextMonth_Click" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="MON" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="TUE" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="WED" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="THU" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="FRI" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="SAT" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="SUN" Style="{StaticResource MutedText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </UniformGrid>

                        <UniformGrid x:Name="DayGrid" Columns="7" />

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Rent due" Style="{StaticResource MutedText}" Margin="6,0,16,0" />
                            <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Payment" Style="{StaticResource MutedText}" Margin="6,0,16,0" />
                            <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Utility" Style="{StaticResource MutedText}" Margin="6,0,16,0" />
                            <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource OccupiedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Move in / out" Style="{StaticResource MutedText}" Margin="6,0,0,0" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="DayDetailTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <StackPanel x:Name="DayDetailList" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}"
                                   FontSize="18" Margin="0,0,0,12" />
                        <StackPanel x:Name="ActivityList" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>
        </Border>
    </ScrollViewer>
</Page>