<ui:FluentWindow x:Class="Nexabode.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Nexabode - Sign in" Height="600" Width="460"
                 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource AppBackgroundBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <ui:TitleBar Title="Nexabode" VerticalAlignment="Top" ShowMaximize="False" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,0">
            <!-- Logo and name -->
            <Border Width="52" Height="52" CornerRadius="13" HorizontalAlignment="Center"
                    Background="{DynamicResource AppPrimaryBrush}">
                <TextBlock Text="N" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Nexabode" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppTextBrush}" Margin="0,14,0,2" />
            <TextBlock Text="Boarding house management" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,0,0,22" />

            <!-- Sign-in card -->
            <Border Width="340" Padding="26" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Sign in" Style="{StaticResource SectionTitle}" FontSize="18"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,12" />

                    <TextBlock Text="Password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" />

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />

                    <ui:Button x:Name="LoginButton" Content="Sign in" Appearance="Primary"
                               HorizontalAlignment="Stretch" IsDefault="True"
                               Click="LoginButton_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Bed occupancy and payment monitoring" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>