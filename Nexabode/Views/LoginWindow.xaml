<ui:FluentWindow x:Class="Nexabode.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Nexabode - Login" Height="480" Width="400"
                 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <ui:TitleBar Title="Nexabode" VerticalAlignment="Top" ShowMaximize="False" />

        <StackPanel VerticalAlignment="Center" Margin="40,20,40,0">
            <TextBlock Text="Nexabode" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Boarding House Management" Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,0,0,30" />

            <ui:TextBox x:Name="UsernameBox" PlaceholderText="Username" Margin="0,0,0,12" />
            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="Password" Margin="0,0,0,12" />

            <TextBlock x:Name="ErrorText" Foreground="IndianRed"
                       Visibility="Collapsed" Margin="0,0,0,12" />

            <ui:Button x:Name="LoginButton" Content="Log in" Appearance="Primary"
                       HorizontalAlignment="Stretch" IsDefault="True"
                       Click="LoginButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>