<Window x:Class="Nexabode.Views.ImpactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="620" SizeToContent="Height" MaxHeight="720" MinWidth="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,20">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="This change affects the records below. Check them before you save it." />

            <!-- The report is drawn here, in code, from the marked lines of the text. It scrolls when it is long. -->
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ReportPanel" Margin="0,0,12,0" />
            </ScrollViewer>
        </StackPanel>

        <!-- The same command area as the other dialogs -->
        <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Go back" IsCancel="True" IsDefault="True"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="34" />
                <ui:Button x:Name="ApplyButton" Grid.Column="2" Content="Save changes" Appearance="Primary"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="34"
                           Click="Apply_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
