<Window x:Class="Nexabode.Views.ChangeUsernameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="Change username" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Text="New username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,4" />
        <TextBlock Text="3 to 32 characters: letters, numbers, dots, dashes and underscores."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="Current password (to confirm it is you)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="PasswordInput" Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Content="Save username" Appearance="Primary" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>