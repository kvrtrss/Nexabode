<Window x:Class="Nexabode.Views.BackupPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock x:Name="PasswordLabel" Text="Backup password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" />

        <StackPanel x:Name="ConfirmPanel">
            <TextBlock x:Name="ConfirmLabel" Text="Confirm backup password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="ConfirmInput" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>