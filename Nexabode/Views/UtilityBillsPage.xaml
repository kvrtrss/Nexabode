<Page x:Class="Nexabode.Views.UtilityBillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Utility Bills">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Utility Bills"
                             Subtitle="Record utility costs and split them among tenants."
                             ActionText="Add bill"
                             ActionClick="AddBill_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="ElectricityCard" Label="Electricity" Margin="0,0,12,0" />
            <controls:StatCard x:Name="WaterCard" Label="Water" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OtherCard" Label="Other utilities" Margin="0,0,12,0" />
            <controls:StatCard x:Name="TotalCard" Label="Total utilities" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <ComboBox x:Name="MonthCombo" Width="190" DisplayMemberPath="Display"
                      SelectionChanged="MonthCombo_SelectionChanged" />
            <CheckBox x:Name="ShowArchivedCheck" Content="Show archived" Margin="20,0,0,0"
          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
        </StackPanel>
        <ui:Card Grid.Row="3" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="New utility bill" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="UtilityTypeBox" IsEditable="True" Width="150" Margin="0,0,8,8">
                        <ComboBoxItem Content="Electricity" />
                        <ComboBoxItem Content="Water" />
                        <ComboBoxItem Content="Internet" />
                        <ComboBoxItem Content="Other" />
                    </ComboBox>
                    <ui:TextBox x:Name="BillAmountBox" PlaceholderText="Total bill amount"
                                Width="160" Margin="0,0,8,8" />
                    <ComboBox x:Name="ScopeCombo" Width="170" DisplayMemberPath="Display" Margin="0,0,8,8" />
                    <DatePicker x:Name="BillDuePicker" Width="160" Margin="0,0,8,8"
                                ToolTip="Due date of each tenant's share" />
                    <DatePicker x:Name="PeriodFromPicker" Width="150" Margin="0,0,8,8"
                                ToolTip="Optional: the first day this bill covers" />
                    <DatePicker x:Name="PeriodToPicker" Width="150" Margin="0,0,0,8"
                                ToolTip="Optional: the last day this bill covers" />
                </WrapPanel>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Billing period (optional): the last two dates. Leave both blank if the bill covers the whole month. Pick both for a bill that spans months, for example Sep 15 to Oct 14. It is listed under the month selected above." />
            </StackPanel>
        </ui:Card>

        <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
            <ui:Button x:Name="SplitButton" Content="Split selected bill" Appearance="Primary"
               Click="SplitBill_Click" IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="UndoButton" Content="Undo split" Click="UndoSplit_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="RecalcButton" Content="Recalculate shares" Click="Recalculate_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="EditButton" Content="Edit bill" Click="EditBill_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="DeleteButton" Content="Delete bill" Click="DeleteBill_Click"
               IsEnabled="False" Margin="0,0,20,6" />
            <ui:Button x:Name="ArchiveButton" Content="Archive" Click="Archive_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="UnarchiveButton" Content="Unarchive" Click="Unarchive_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="ArchiveSettledButton" Content="Archive all settled"
               Click="ArchiveSettled_Click" Margin="0,0,0,6" />
        </WrapPanel>

        <DataGrid x:Name="BillGrid" Grid.Row="5" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                  SelectionChanged="BillGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Utility" Binding="{Binding UtilityType}" Width="*" />
                <DataGridTextColumn Header="Applies to" Binding="{Binding Scope}" Width="170" />
                <DataGridTextColumn Header="Period" Binding="{Binding PeriodText}" Width="210" />
                <DataGridTextColumn Header="Total bill" Binding="{Binding Total, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="130" />
                <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="130" />
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding StatusText}"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>