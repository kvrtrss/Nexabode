<Window x:Class="Nexabode.Views.FormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12" />
        <StackPanel x:Name="FieldPanel" Margin="0,10,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>