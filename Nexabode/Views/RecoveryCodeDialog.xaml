<Window x:Class="Nexabode.Views.RecoveryCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <!-- The code, large and easy to copy down by hand -->
        <Border CornerRadius="8" Padding="16,18" Margin="0,0,0,14" BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel>
                <TextBlock x:Name="CaptionText" Text="RECOVERY CODE" Style="{StaticResource MutedText}" FontSize="11"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"
                           AutomationProperties.Name="Code" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource BannerWarning}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="WarnTitle" Text="This code is shown only once" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock x:Name="WarnBody" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Write it down and keep it somewhere private, away from this computer. Anyone who has it can reset your password, so do not share it. Nexabode stores only a protected copy and cannot show it again." />
            </StackPanel>
        </Border>

        <!-- Paper is the safest place for it: print it, or write it by hand. -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="PrintButton" Content="Print recovery sheet" Click="Print_Click"
                       VerticalAlignment="Top"
                       ToolTip="Print this on paper. Nothing is saved on this computer." />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12"
                       Margin="12,2,0,0"
                       Text="The sheet explains how to use it. Keep the paper in a locked place, and do not save it as a file on this computer." />
        </Grid>

        <CheckBox x:Name="SavedCheck" Content="I have written down my recovery code"
                  Checked="SavedCheck_Changed" Unchecked="SavedCheck_Changed" />

        <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="LaterButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="ContinueButton" Content="Continue" Appearance="Primary"
                       FontWeight="SemiBold" IsDefault="True" IsEnabled="False" Click="Continue_Click" />
        </StackPanel>
    </StackPanel>
</Window>
