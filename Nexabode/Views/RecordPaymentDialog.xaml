<Window x:Class="Nexabode.Views.RecordPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Title="Record a payment" Width="800" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Recording a payment has its own window, so the Payments page keeps all its room for the list.
         Left: who is paying and for what. Right: how and when. The buttons stay in view when the fields scroll. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Record a payment" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Who and what for -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tenant" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="TenantCombo" DisplayMemberPath="Name" Margin="0,0,0,6"
                              AutomationProperties.Name="Tenant" SelectionChanged="TenantCombo_SelectionChanged" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="0,0,0,12" Text="Select a tenant to begin." />

                    <TextBlock Text="Paying for" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="PayForCombo" DisplayMemberPath="Display" Margin="0,0,0,12"
                              AutomationProperties.Name="What the tenant is paying for"
                              SelectionChanged="PayFor_SelectionChanged" />
                    <!-- Takes no room until there is something to say. -->
                    <TextBlock x:Name="PayForHint" TextWrapping="Wrap" Margin="0,-6,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Only for "One specific charge" -->
                    <StackPanel x:Name="ChargePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Choose the charge" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <DataGrid x:Name="ChargeList" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single" MaxHeight="190"
                                  AutomationProperties.Name="Unpaid charges of this tenant"
                                  SelectionChanged="ChargeList_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Charge" Binding="{Binding Description}" Width="1.6*" MinWidth="110" />
                                <DataGridTextColumn Header="Month" Binding="{Binding BillingMonth}" Width="1*" MinWidth="80" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                    ElementStyle="{StaticResource RightCell}" Width="1.1*" MinWidth="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <TextBlock Text="Amount received" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="AmountBox" Margin="0,0,0,4" TextChanged="AmountBox_TextChanged"
                                AutomationProperties.Name="Amount received" />
                    <ui:Button x:Name="FillBalanceButton" Appearance="Transparent" Padding="2,2"
                               HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,2"
                               ToolTip="Fill in the full amount owed for what is selected. Change it if the tenant paid a different amount."
                               Click="FillBalance_Click" />
                    <TextBlock x:Name="ChangeHint" TextWrapping="Wrap" FontWeight="SemiBold"
                               Visibility="Collapsed" Margin="0,0,0,6" />
                </StackPanel>

                <!-- How and when -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Method" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="MethodCombo" IsEditable="True" Margin="0,0,0,12"
                              AutomationProperties.Name="Payment method">
                        <ComboBoxItem Content="Cash" />
                        <ComboBoxItem Content="GCash" />
                        <ComboBoxItem Content="Bank transfer" />
                        <ComboBoxItem Content="Other" />
                    </ComboBox>

                    <!-- Only for payments that come with a reference from outside (GCash, bank, check). Hidden for cash. -->
                    <StackPanel x:Name="ReferencePanel" Visibility="Collapsed">
                        <TextBlock Text="Reference no." Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="ReferenceBox" PlaceholderText="From GCash, the bank or the check"
                                    Margin="0,0,0,12" AutomationProperties.Name="Reference number" />
                    </StackPanel>

                    <TextBlock Text="Payment date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <DatePicker x:Name="PayDatePicker" Margin="0,0,0,12" SelectedDateChanged="PayDate_Changed"
                                AutomationProperties.Name="Payment date" />

                    <TextBlock Text="Remarks" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="RemarksBox" Margin="0,0,0,6" AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="72" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                AutomationProperties.Name="Remarks" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Filled in by Nexabode: the number this payment will get. Nobody types it. -->
            <TextBlock x:Name="ReceiptNoText" Style="{StaticResource MutedText}" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <ui:Button Content="Record payment" Appearance="Primary" IsDefault="True" MinWidth="150"
                           FontWeight="SemiBold" Click="RecordPayment_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
