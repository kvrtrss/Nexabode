<Page x:Class="Nexabode.Views.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Rooms and Beds">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Rooms &amp; Beds"
                             Subtitle="Manage room inventory, availability, and bed assignments."
                             ActionText="Add room"
                             ActionClick="AddRoom_Click" />

        <!-- Filter chips and search -->
        <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="ChipPanel" VerticalAlignment="Center" />
                <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="220"
                            PlaceholderText="Search rooms" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Room cards -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="RoomWrap" />
            </ScrollViewer>

            <!-- Details of the selected room -->
            <ui:Card Grid.Column="2" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Text="Click a room card to see its beds and manage them here." />

                    <StackPanel x:Name="DetailBody" Visibility="Collapsed">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock x:Name="DetailSub" Style="{StaticResource MutedText}" Margin="0,2,0,12" />

                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button Content="Edit room" Click="EditRoom_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="RoomToggleButton" Click="ToggleRoom_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="AddBedButton" Content="Add bed" Appearance="Primary"
                                       Click="AddBed_Click" Margin="0,0,0,8" />
                        </WrapPanel>

                        <DataGrid x:Name="BedGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single" MaxHeight="300"
                                  SelectionChanged="BedGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bed" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Rent" Binding="{Binding Rate, StringFormat='₱{0:N2}'}"
                                                    ElementStyle="{StaticResource RightCell}" Width="95" />
                                <DataGridTemplateColumn Header="Status" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}"
                                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button x:Name="EditBedButton" Content="Edit bed" Click="EditBed_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="DeactivateBedButton" Content="Deactivate bed" Click="DeactivateBed_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="ActivateBedButton" Content="Activate bed" Click="ActivateBed_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="StartMaintButton" Content="Start maintenance" Click="StartMaintenance_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="EndMaintButton" Content="End maintenance" Click="EndMaintenance_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>