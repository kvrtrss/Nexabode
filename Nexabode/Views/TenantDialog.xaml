<Window x:Class="Nexabode.Views.TenantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Width="480" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Add tenant and Edit tenant. Laid out like Edit stay and Move in: same width, title, labels and buttons. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                       FontSize="18" Margin="0,0,0,6" />
            <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8" />

            <TextBlock Text="Full name (required)" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" />

            <TextBlock Text="Gender" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ComboBox x:Name="GenderCombo" Margin="0,0,0,12" HorizontalAlignment="Stretch" />

            <TextBlock Text="Contact number" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="ContactBox" Margin="0,0,0,12" />

            <TextBlock Text="Emergency contact" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="EmergencyBox" Margin="0,0,0,12" />

            <TextBlock Text="School or work" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="SchoolBox" Margin="0,0,0,12" />

            <TextBlock Text="Notes" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NotesBox" Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap"
                        MinHeight="72" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

            <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
