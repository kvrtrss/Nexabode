<Window x:Class="Nexabode.Views.GenerateRentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Generate rent" Width="760" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource SectionTitle}" FontSize="18" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rent is due on" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <DatePicker x:Name="DuePicker" Width="250" SelectedDateChanged="Options_Changed"
                            AutomationProperties.Name="Rent due date" />
            </StackPanel>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="The usual due day comes from Settings. A tenant who moves in after this date is due on their move-in day." />
            <CheckBox x:Name="FullRentCheck" Content="Charge full rent for partial months" Margin="0,10,0,0"
                      ToolTip="By default, a stay that does not cover the whole month is charged by the number of days. Tick this to charge the full monthly rent instead."
                      Checked="Options_Changed" Unchecked="Options_Changed" />
        </StackPanel>

        <DataGrid x:Name="LineGrid" Grid.Row="2" Margin="0,14,0,0" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- MinWidth 0: the default tick box style is wide enough for a label, which cut the box off in a narrow column. -->
                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="0" Padding="0" Margin="0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="Include this tenant" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="1.5*" MinWidth="110" />
                <DataGridTextColumn Header="Bed" Binding="{Binding Bed}" Width="2.4*" MinWidth="200" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="Rent" Binding="{Binding Rent}"
                                    ElementStyle="{StaticResource RightCell}" Width="1*" MinWidth="90" />
                <DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="1*" MinWidth="100" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Style="{StaticResource MutedText}" Margin="0,10,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="GenerateButton" Appearance="Primary" FontWeight="SemiBold" IsDefault="True"
                       Click="Generate_Click" />
        </StackPanel>
    </Grid>
</Window>
