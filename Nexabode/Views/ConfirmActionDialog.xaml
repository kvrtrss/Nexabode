<Window x:Class="Nexabode.Views.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Please confirm" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,22">
            <TextBlock Text="Are you sure?" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,10" />

            <!-- A long list of changes scrolls instead of making the window taller than the screen -->
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}" />
            </ScrollViewer>
        </StackPanel>

        <!-- The command area: a slightly different shade, set off by a hairline, as in Windows dialogs.
             Two buttons of the same width (whatever the longer label needs), the main action on the right. -->
        <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <UniformGrid Rows="1" HorizontalAlignment="Right">
                <ui:Button Content="Back" IsCancel="True" MinWidth="120" MinHeight="34" Margin="0,0,4,0"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <ui:Button x:Name="ConfirmButton" Content="Confirm" Appearance="Primary" IsDefault="True"
                           MinWidth="120" MinHeight="34" Margin="4,0,0,0"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Confirm_Click" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
