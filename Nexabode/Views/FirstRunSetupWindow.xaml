<ui:FluentWindow x:Class="Nexabode.Views.FirstRunSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Nexabode.Controls"
                 Title="Nexabode - Welcome" Height="700" Width="460"
                 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource AppBackgroundBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <ui:TitleBar Title="Nexabode" VerticalAlignment="Top" ShowMaximize="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" Margin="0,32,0,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Nexabode logo" />
            <TextBlock Text="Welcome to Nexabode" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppTextBrush}" Margin="0,14,0,2" />
            <TextBlock Text="Boarding house management" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,0,0,22" />

            <Border Width="340" Padding="26" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Create your Owner account" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <TextBlock Text="You will use it to sign in and manage everything. Next, you will get a recovery key to keep in a safe place."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,18" />

                    <TextBlock Text="Username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,14" AutomationProperties.Name="Username" />

                    <TextBlock Text="Password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="NewBox" Margin="0,0,0,8" AutomationProperties.Name="Password" />
                    <controls:PasswordStrengthMeter x:Name="StrengthMeter" />

                    <TextBlock Text="Confirm password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="ConfirmBox" Margin="0,0,0,6" AutomationProperties.Name="Confirm password" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Use at least 8 characters. Use 3 to 32 letters, numbers, dots, dashes or underscores for the username." />

                    <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,12" />

                    <ui:Button x:Name="ContinueButton" Content="Continue" Appearance="Primary"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="0,9" FontWeight="SemiBold" IsDefault="True"
                               Click="Continue_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
