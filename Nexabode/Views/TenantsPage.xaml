<Page x:Class="Nexabode.Views.TenantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Tenants">
    <Page.Resources>
        <!-- Rows keep a steady height: two lines (a name, then a detail line). -->
        <Style x:Key="TallCell" TargetType="DataGridCell" BasedOn="{StaticResource AppCellStyle}">
            <Setter Property="MinHeight" Value="58" />
        </Style>
        <!-- Second line of a row. On a narrow list (the list sets its Tag to "Compact") the bed joins it, because the Bed column is hidden. -->
        <Style x:Key="LineTwoFull" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Compact">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineTwoCompact" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Compact">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto" Background="Transparent">
    <Border Padding="32,24" MinWidth="640" MinHeight="640"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Tenants"
                             Subtitle="Manage tenant records, stays, and balances."
                             ActionText="Add tenant"
                             ActionClick="AddTenant_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="TotalCard" Label="Total tenants" Margin="0,0,12,0" />
            <controls:StatCard x:Name="StayingCard" Label="Staying" Margin="0,0,12,0" />
            <controls:StatCard x:Name="ReservedCard" Label="Reserved" Margin="0,0,12,0" />
            <controls:StatCard x:Name="BalanceCard" Label="Balance due" />
        </UniformGrid>

        <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="12,10">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarButton}" />
                </WrapPanel.Resources>
                <ComboBox x:Name="FilterCombo" Width="170" Margin="0,2,12,2"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All tenants" IsSelected="True" />
                    <ComboBoxItem Content="Moving out" />
                    <ComboBoxItem Content="Staying" />
                    <ComboBoxItem Content="Reserved" />
                    <ComboBoxItem Content="Moved out" />
                    <ComboBoxItem Content="No stay yet" />
                    <ComboBoxItem Content="Has balance" />
                </ComboBox>
                <CheckBox x:Name="ShowArchivedCheck" Content="Show moved-out tenants" Margin="0,2,12,2"
                          VerticalAlignment="Center"
                          ToolTip="Moved-out tenants who still owe money, or still have deposit left, are always shown."
                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
                <ui:TextBox x:Name="SearchBox" Width="280" Margin="0,2,16,2"
                            PlaceholderText="Search by name, contact, or bed"
                            TextChanged="SearchBox_TextChanged" />

                <!-- For the selected tenant. Everything else (deposit, stay history, ...) is in the details window. -->
                <ui:Button x:Name="ViewButton" Content="View details" Appearance="Primary" IsEnabled="False"
                           Click="ViewDetails_Click" Margin="0,2,8,2"
                           ToolTip="Opens everything about the selected tenant. Double-click a row to open it too." />
                <ui:Button x:Name="AccountToolbarButton" Content="Tenant account" IsEnabled="False" Click="ViewAccount_Click" Margin="0,2,8,2"
                           ToolTip="Everything this tenant owes and has paid." />
                <ui:Button x:Name="EditTenantButton" Content="Edit tenant" IsEnabled="False" Click="EditTenant_Click" Margin="0,2,8,2" />
                <ui:Button x:Name="MoveInToolbarButton" Content="Move in" IsEnabled="False" Click="MoveIn_Click" Margin="0,2,8,2" />
                <ui:Button x:Name="MoveOutToolbarButton" Content="Move out" IsEnabled="False" Click="MoveOut_Click" Margin="0,2,0,2" />
            </WrapPanel>
        </ui:Card>

        <Grid Grid.Row="3">
            <DataGrid x:Name="TenantGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      RowHeight="NaN" CellStyle="{StaticResource TallCell}"
                      SizeChanged="TenantGrid_SizeChanged"
                      MouseDoubleClick="TenantGrid_MouseDoubleClick"
                      SelectionChanged="TenantGrid_SelectionChanged">
                <DataGrid.Columns>
                    <!-- Three columns with two lines each, using the whole page width, so nothing is cut off and nothing needs a
                         side scroll bar: who / where they stay / what they owe. Everything else is in the details window. -->
                    <DataGridTemplateColumn Header="Tenant" SortMemberPath="FullName" Width="2.2*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="0,6">
                                    <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LineTwo}" Style="{StaticResource LineTwoFull}" />
                                    <TextBlock Text="{Binding LineTwoCompact}" Style="{StaticResource LineTwoCompact}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="BedColumn" Header="Bed" SortMemberPath="CurrentBed" Width="2*" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="0,6">
                                    <TextBlock Text="{Binding BedText}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BedLineTwo}" Style="{StaticResource MutedText}"
                                               FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Balance" HeaderStyle="{StaticResource RightColumnHeaderStyle}" SortMemberPath="Balance" Width="1.2*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="0,6" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Balance, StringFormat='₱{0:N2}'}" FontWeight="SemiBold"
                                               FontSize="15" HorizontalAlignment="Right" />
                                    <ContentPresenter Content="{Binding Status}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                      ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </Border>
    </ScrollViewer>
</Page>