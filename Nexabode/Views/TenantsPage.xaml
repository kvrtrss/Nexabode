<Page x:Class="Nexabode.Views.TenantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Tenants">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Tenants"
                             Subtitle="Manage tenant records, stays, and balances."
                             ActionText="Add tenant"
                             ActionClick="AddTenant_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="TotalCard" Label="Total tenants" Margin="0,0,12,0" />
            <controls:StatCard x:Name="StayingCard" Label="Staying" Margin="0,0,12,0" />
            <controls:StatCard x:Name="ReservedCard" Label="Reserved" Margin="0,0,12,0" />
            <controls:StatCard x:Name="BalanceCard" Label="Balance due" />
        </UniformGrid>

        <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="FilterCombo" Width="170" Margin="0,0,12,0"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All tenants" IsSelected="True" />
                    <ComboBoxItem Content="Staying" />
                    <ComboBoxItem Content="Reserved" />
                    <ComboBoxItem Content="Moved out" />
                    <ComboBoxItem Content="No stay yet" />
                    <ComboBoxItem Content="Has balance" />
                </ComboBox>
                <CheckBox x:Name="ShowArchivedCheck" Content="Show moved-out tenants" Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          ToolTip="Moved-out tenants who still owe money are always shown."
                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
                <ui:TextBox x:Name="SearchBox" Width="280"
                            PlaceholderText="Search by name, contact, or bed"
                            TextChanged="SearchBox_TextChanged" />
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="TenantGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      SelectionChanged="TenantGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="130" />
                    <DataGridTextColumn Header="Current bed" Binding="{Binding CurrentBed}" Width="150" />
                    <DataGridTextColumn Header="Move-in" Binding="{Binding MoveInText}" Width="110" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                        ElementStyle="{StaticResource RightCell}" Width="110" />
                    <DataGridTemplateColumn Header="Status" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Status}"
                                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ui:Card Grid.Column="2" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Click a tenant to see their details, stay history, and actions." />

                    <StackPanel x:Name="DetailBody" Visibility="Collapsed">
                        <TextBlock x:Name="DetailName" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <ContentPresenter x:Name="DetailBadge" HorizontalAlignment="Left" Margin="0,6,0,12"
                                          ContentTemplate="{StaticResource StatusBadgeTemplate}" />

                        <StackPanel x:Name="InfoPanel" Margin="0,0,0,12" />

                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button x:Name="EditButton" Content="Edit tenant" Click="EditTenant_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="EditStayButton" Content="Edit stay" Click="EditStay_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="MoveInButton" Content="Move in" Appearance="Primary"
                                       Click="MoveIn_Click" Margin="0,0,8,8" />
                            <ui:Button x:Name="MoveOutButton" Content="Move out" Click="MoveOut_Click" Margin="0,0,0,8" />
                        </WrapPanel>

                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Stay history" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <StackPanel x:Name="HistoryPanel" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>