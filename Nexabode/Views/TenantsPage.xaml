<Page x:Class="Nexabode.Views.TenantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Tenants">
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Tenants" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Add tenant -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:TextBox x:Name="NameBox" PlaceholderText="Full name" Width="220" Margin="0,0,8,0" />
            <ui:TextBox x:Name="ContactBox" PlaceholderText="Contact number" Width="160" Margin="0,0,8,0" />
            <ui:TextBox x:Name="EmergencyBox" PlaceholderText="Emergency contact" Width="180" Margin="0,0,8,0" />
            <ui:TextBox x:Name="SchoolBox" PlaceholderText="School / Work" Width="160" Margin="0,0,8,0" />
            <ui:Button Content="Add tenant" Appearance="Primary" Click="AddTenant_Click" />
        </StackPanel>

        <!-- Tenant list -->
        <DataGrid x:Name="TenantGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" Margin="0,0,0,16"
                  SelectionChanged="TenantGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="140" />
                <DataGridTextColumn Header="School / Work" Binding="{Binding SchoolOrWork}" Width="150" />
                <DataGridTextColumn Header="Current bed" Binding="{Binding CurrentBed}" Width="170" />
                <DataGridTextColumn Header="Move-in" Binding="{Binding MoveIn}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Move in / move out -->
        <UniformGrid Grid.Row="3" Columns="2">
            <ui:Card Margin="0,0,10,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Move in (selected tenant)" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox x:Name="BedCombo" DisplayMemberPath="Display" Margin="0,0,0,8"
                              SelectionChanged="BedCombo_SelectionChanged" />
                    <DatePicker x:Name="MoveInPicker" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:TextBox x:Name="RentBox" PlaceholderText="Agreed monthly rent"
                                    Width="170" Margin="0,0,8,0" />
                        <ui:TextBox x:Name="DepositBox" PlaceholderText="Deposit" Width="120" />
                    </StackPanel>
                    <ui:Button Content="Move in" Appearance="Primary" Click="MoveIn_Click" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="10,0,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Move out (selected tenant)" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DatePicker x:Name="MoveOutPicker" Margin="0,0,0,8" />
                    <ui:Button Content="Move out" Click="MoveOut_Click" />
                </StackPanel>
            </ui:Card>
        </UniformGrid>
    </Grid>
</Page>