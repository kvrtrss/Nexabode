<Window x:Class="Nexabode.Views.StayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,8" />

        <!-- Move in -->
        <StackPanel x:Name="MoveInPanel" Margin="0,10,0,0">
            <TextBlock Text="Bed" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ComboBox x:Name="BedCombo" DisplayMemberPath="Display" Margin="0,0,0,12" />
            <TextBlock Text="Move-in date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <DatePicker x:Name="MoveInDate" Margin="0,0,0,12" />
            <TextBlock Text="Agreed monthly rent" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="RentBox" Margin="0,0,0,12" />
            <TextBlock Text="Move-out date (optional, leave blank if still staying)"
                       Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <DatePicker x:Name="NewMoveOutDate" Margin="0,0,0,12" />
            <TextBlock Text="Deposit (optional)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="DepositBox" Margin="0,0,0,12" />
        </StackPanel>

        <!-- Move out -->
        <StackPanel x:Name="MoveOutPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="Move-out date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <DatePicker x:Name="MoveOutDate" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>