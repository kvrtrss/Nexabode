<Page x:Class="Nexabode.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Payments">
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Payments" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Tenant:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="TenantCombo" Width="300" DisplayMemberPath="Name"
                      SelectionChanged="TenantCombo_SelectionChanged" />
        </StackPanel>

        <TextBlock x:Name="SummaryText" Grid.Row="2" Grid.ColumnSpan="3"
                   FontWeight="SemiBold" Margin="0,0,0,12" Text="Select a tenant to begin." />

        <!-- Left: record payment -->
        <ui:Card Grid.Row="3" Grid.Column="0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Record a payment" FontWeight="SemiBold" Margin="0,0,0,10" />

                <DatePicker x:Name="PayDatePicker" Margin="0,0,0,8" />
                <ui:TextBox x:Name="AmountBox" PlaceholderText="Amount received" Margin="0,0,0,8" />
                <ComboBox x:Name="MethodCombo" IsEditable="True" Margin="0,0,0,8">
                    <ComboBoxItem Content="Cash" />
                    <ComboBoxItem Content="GCash" />
                    <ComboBoxItem Content="Bank transfer" />
                    <ComboBoxItem Content="Other" />
                </ComboBox>
                <ui:TextBox x:Name="ReferenceBox" PlaceholderText="Reference no. (optional)" Margin="0,0,0,8" />
                <ui:TextBox x:Name="RemarksBox" PlaceholderText="Remarks (optional)" Margin="0,0,0,12" />

                <RadioButton x:Name="OldestRadio" GroupName="Apply" IsChecked="True"
                             Content="Apply to oldest charges first" Margin="0,0,0,4" />
                <RadioButton x:Name="SelectedRadio" GroupName="Apply"
                             Content="Apply to the charge selected on the right" Margin="0,0,0,12" />

                <ui:Button Content="Record payment" Appearance="Primary"
                           HorizontalAlignment="Stretch" Click="RecordPayment_Click" />
            </StackPanel>
        </ui:Card>

        <!-- Right: tabs -->
        <TabControl Grid.Row="3" Grid.Column="2">
            <TabItem Header="Unpaid charges">
                <DataGrid x:Name="ChargeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month" Binding="{Binding BillingMonth}" Width="90" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Payment history">
                <DataGrid x:Name="PaymentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="110" />
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="140" />
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="All balances">
                <DataGrid x:Name="BalanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                        <DataGridTextColumn Header="Total billed" Binding="{Binding Billed, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="Total paid" Binding="{Binding Paid, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="Overdue" Binding="{Binding Overdue, StringFormat=N2}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>