<Page x:Class="Nexabode.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      xmlns:svc="clr-namespace:Nexabode.Services"
      Title="Payments">
    <Page.Resources>
        <svc:SubtractConverter x:Key="Minus" />
        <!-- Rows keep their usual height, and grow only when a payment is selected and its details open. -->
        <Style x:Key="TallCell" TargetType="DataGridCell" BasedOn="{StaticResource AppCellStyle}">
            <Setter Property="MinHeight" Value="58" />
        </Style>
        <!-- Second line of a row. On a narrow table (the table sets its Tag to "Compact") the date joins it, because the date column is hidden. -->
        <Style x:Key="LineTwoFull" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Compact">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineTwoCompact" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Compact">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Long text is cut with "..." and the full text shows when the mouse rests on it. -->
        <Style x:Key="TrimWithTip" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto" Background="Transparent">
    <Border Padding="32,24" MinWidth="640" MinHeight="600"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Payments"
                             Subtitle="Record payments, review history, and correct mistakes."
                             ActionText="Record payment"
                             ActionClick="OpenForm_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="MonthCard" Label="Collected this month" Margin="0,0,12,0" />
            <controls:StatCard x:Name="TodayCard" Label="Collected today" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OutstandingCard" Label="Outstanding" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <Grid Grid.Row="2">

            <!-- Tabs -->
            <TabControl x:Name="Tabs">
                <TabItem Header="Payment history">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,10">
                            <!-- Search and view options -->
                            <WrapPanel>
                                <ui:TextBox x:Name="SearchBox" Width="300" Margin="0,0,16,8"
                                            PlaceholderText="Search tenant, method, or reference"
                                            TextChanged="SearchBox_TextChanged" />
                                <CheckBox x:Name="ShowVoidedCheck" Content="Show voided"
                                          VerticalAlignment="Center" Margin="0,0,16,8"
                                          Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
                                <CheckBox x:Name="ShowArchivedCheck" Content="Show archived"
                                          VerticalAlignment="Center" Margin="0,0,0,8"
                                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
                            </WrapPanel>

                            <!-- Actions: change a payment | tidy up -->
                            <WrapPanel>
                                <WrapPanel.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarButton}" />
            </WrapPanel.Resources>
                                <ui:Button x:Name="EditButton" Content="Edit payment" Click="EditPayment_Click" IsEnabled="False" />
                                <ui:Button x:Name="VoidButton" Content="Void payment" Click="VoidPayment_Click" IsEnabled="False"
                                           Style="{StaticResource DangerToolbarButton}" />
                                <ui:Button x:Name="PrintReceiptButton" Content="Print receipt" Click="PrintReceipt_Click" IsEnabled="False" />
                                <ui:Button x:Name="MoreButton" Content="More" Click="More_Click"
                                           ToolTip="Archive or unarchive payments you no longer need in the list.">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="ArchiveButton" Header="Archive" Click="Archive_Click" IsEnabled="False" />
                                            <MenuItem x:Name="UnarchiveButton" Header="Unarchive" Click="Unarchive_Click" IsEnabled="False" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </WrapPanel>

                        </StackPanel>

                        <!-- Shown on top of the empty table, so a blank area explains itself and says what to do. -->
                        <TextBlock x:Name="EmptyText" Grid.Row="1" Panel.ZIndex="1" Style="{StaticResource MutedText}"
                                   Text="No payments to show. Select Record payment at the top of the page and the payment will appear here."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="380" IsHitTestVisible="False" Visibility="Collapsed" />
                        <DataGrid x:Name="PaymentGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                                  RowHeight="NaN" CellStyle="{StaticResource TallCell}"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  SizeChanged="PaymentGrid_SizeChanged"
                                  SelectionChanged="PaymentGrid_SelectionChanged">
                            <!-- Select a payment and its details open under it: only what the table has no column for.
                                 Nothing takes room on the page while no payment is selected. -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="14,0,14,12"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource Minus}, ConverterParameter=70}">
                                        <TextBlock Text="{Binding DetailsMain}" Style="{StaticResource MutedText}"
                                                   FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PaidForFull}" Style="{StaticResource MutedText}"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <!-- Three columns with two lines each, so nothing is cut off and nothing needs a side scroll bar:
                                     who and what for / receipt and date / amount and status. Change, the reference and the full
                                     breakdown are in the details that open under a selected row. -->
                                <DataGridTemplateColumn Header="Payment" SortMemberPath="Tenant" Width="2.4*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6">
                                                <TextBlock Text="{Binding Tenant}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LineTwo}" Style="{StaticResource LineTwoFull}" />
                                                <TextBlock Text="{Binding LineTwoCompact}" Style="{StaticResource LineTwoCompact}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ReceiptColumn" Header="Receipt" SortMemberPath="ReceiptNo" Width="1.4*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6">
                                                <TextBlock Text="{Binding ReceiptNo}" FontSize="14" />
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Amount" HeaderStyle="{StaticResource RightColumnHeaderStyle}" SortMemberPath="Received" Width="1.2*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Received, StringFormat='₱{0:N2}'}" FontWeight="SemiBold"
                                                           FontSize="15" HorizontalAlignment="Right" />
                                                <ContentPresenter Content="{Binding Status}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Unpaid charges">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,10">
                            <WrapPanel.Resources>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarButton}" />
                            </WrapPanel.Resources>
                            <ui:Button x:Name="RecordForChargeButton" Content="Record payment for this charge"
                                       Click="RecordForCharge_Click" IsEnabled="False"
                                       ToolTip="Opens the Record payment window with this tenant and charge already chosen." />
                        </WrapPanel>

                        <!-- Every tenant's unpaid charges, oldest due date first. Two lines per row, like the payment history. -->
                        <DataGrid x:Name="ChargeGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  RowHeight="NaN" CellStyle="{StaticResource TallCell}"
                                  SelectionChanged="ChargeGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tenant and charge" SortMemberPath="Tenant" Width="2.4*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6">
                                                <TextBlock Text="{Binding Tenant}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LineTwo}" Style="{StaticResource MutedText}"
                                                           FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Due" SortMemberPath="DueDate" Width="1.3*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding DueText}" FontSize="14" />
                                                <ContentPresenter Content="{Binding Status}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Balance" HeaderStyle="{StaticResource RightColumnHeaderStyle}" SortMemberPath="Balance" Width="1.2*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Balance, StringFormat='₱{0:N2}'}" FontWeight="SemiBold"
                                                           FontSize="15" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Amount, StringFormat='of ₱{0:N2}'}" Style="{StaticResource MutedText}"
                                                           FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="All balances">
                    <DataGrid x:Name="BalanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="0,10,0,0"
                              ToolTip="Double-click a tenant to open their account."
                              MouseDoubleClick="BalanceGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                            <DataGridTextColumn Header="Total billed" Binding="{Binding Billed, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Total paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Overdue" Binding="{Binding Overdue, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    </Border>
    </ScrollViewer>
</Page>