<Page x:Class="Nexabode.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Payments">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto" Background="Transparent">
    <Border Padding="32,24" MinWidth="900" MinHeight="600"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Payments"
                             Subtitle="Record payments, review history, and correct mistakes." />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="MonthCard" Label="Collected this month" Margin="0,0,12,0" />
            <controls:StatCard x:Name="TodayCard" Label="Collected today" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OutstandingCard" Label="Outstanding" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="354" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Record a payment -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <!-- The right 14px is kept free for the scroll bar, so it never sits on top of the content. -->
                <ui:Card VerticalAlignment="Top" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Record a payment" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <!-- Filled in by Nexabode: shows the number this payment will get. Nobody types it. -->
                        <TextBlock Text="Receipt no." Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="ReceiptNoBox" IsReadOnly="True" IsTabStop="False" FontWeight="SemiBold"
                                    Margin="0,0,0,4" AutomationProperties.Name="Receipt number, assigned automatically"
                                    ToolTip="Assigned automatically when you record the payment. It can't be changed." />
                        <TextBlock Text="Assigned automatically." Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,0,0,12" />

                        <TextBlock Text="Tenant" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TenantCombo" DisplayMemberPath="Name" Margin="0,0,0,6"
                                  SelectionChanged="TenantCombo_SelectionChanged" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" Text="Select a tenant to begin." />

                        <TextBlock Text="Payment date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <DatePicker x:Name="PayDatePicker" Margin="0,0,0,10" SelectedDateChanged="PayDate_Changed" />
                        <TextBlock Text="Amount received" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="AmountBox" Margin="0,0,0,4" TextChanged="AmountBox_TextChanged" />
                        <TextBlock x:Name="ChangeHint" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="Collapsed" Margin="0,0,0,10" />
                        <TextBlock Text="Method" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="MethodCombo" IsEditable="True" Margin="0,0,0,10">
                            <ComboBoxItem Content="Cash" />
                            <ComboBoxItem Content="GCash" />
                            <ComboBoxItem Content="Bank transfer" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>
                        <!-- Only for payments that come with a reference from outside (GCash, bank, check). Cash has none, so it is switched off. -->
                        <ui:TextBox x:Name="ReferenceBox" PlaceholderText="GCash, bank or check ref. no."
                                    Margin="0,0,0,10"
                                    ToolTip="Enter the reference number from GCash, the bank or the check. It is not needed for cash payments." />
                        <ui:TextBox x:Name="RemarksBox" PlaceholderText="Remarks (optional)" Margin="0,0,0,14" />

                        <TextBlock Text="What is the tenant paying for?" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="PayForCombo" DisplayMemberPath="Display" Margin="0,0,0,6"
          SelectionChanged="PayFor_SelectionChanged" />
                        <TextBlock x:Name="PayForHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <ui:Button Content="Record payment" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Click="RecordPayment_Click" />

                        <Border x:Name="ReceiptBanner" Style="{StaticResource BannerSuccess}" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock x:Name="ReceiptText" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                </ui:Card>
            </ScrollViewer>

            <!-- Tabs -->
            <TabControl x:Name="Tabs" Grid.Column="2">
                <TabItem Header="Payment history">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,4">
                            <!-- Search and view options -->
                            <WrapPanel>
                                <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,16,8"
                                            PlaceholderText="Search tenant, method, or reference"
                                            TextChanged="SearchBox_TextChanged" />
                                <CheckBox x:Name="ShowVoidedCheck" Content="Show voided"
                                          VerticalAlignment="Center" Margin="0,0,16,8"
                                          Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
                                <CheckBox x:Name="ShowArchivedCheck" Content="Show archived"
                                          VerticalAlignment="Center" Margin="0,0,0,8"
                                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
                            </WrapPanel>

                            <!-- Actions: change a payment | tidy up -->
                            <WrapPanel>
                                <WrapPanel.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarButton}" />
            </WrapPanel.Resources>
                                <ui:Button x:Name="EditButton" Content="Edit payment" Click="EditPayment_Click" IsEnabled="False" />
                                <ui:Button x:Name="VoidButton" Content="Void payment" Click="VoidPayment_Click" IsEnabled="False"
                                           Style="{StaticResource DangerToolbarButton}" />
                                <ui:Button x:Name="PrintReceiptButton" Content="Print receipt" Click="PrintReceipt_Click" IsEnabled="False" />
                                <Border Style="{StaticResource ToolbarDivider}" />
                                <ui:Button x:Name="ArchiveButton" Content="Archive" Click="Archive_Click" IsEnabled="False" />
                                <ui:Button x:Name="UnarchiveButton" Content="Unarchive" Click="Unarchive_Click" IsEnabled="False" />
                            </WrapPanel>

                            <!-- The reference no., remarks and void reason of the selected payment. They are not table columns, so the table stays easy to read. -->
                            <TextBlock x:Name="SelectedInfo" Style="{StaticResource MutedText}" FontSize="12.5"
                                       Margin="2,8,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <DataGrid x:Name="PaymentGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                                  SelectionChanged="PaymentGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt no." Binding="{Binding ReceiptNo}" Width="125" />
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="105" />
                                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="Received" Binding="{Binding Received, StringFormat='₱{0:N2}'}"
                        ElementStyle="{StaticResource RightCell}" Width="105" />
                                <DataGridTextColumn Header="Applied" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                        ElementStyle="{StaticResource RightCell}" Width="105" />
                                <DataGridTextColumn Header="Change" Binding="{Binding Change, StringFormat='₱{0:N2}'}"
                        ElementStyle="{StaticResource RightCell}" Width="95" />
                                <DataGridTextColumn Header="Paid for" Binding="{Binding PaidFor}" Width="140" />
                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="110" />
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}"
                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Unpaid charges">
                    <DataGrid x:Name="ChargeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" Margin="0,10,0,0"
                              SelectionChanged="ChargeGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding BillingMonth}" Width="90" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="110" />
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}"
                                                          ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="All balances">
                    <DataGrid x:Name="BalanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                            <DataGridTextColumn Header="Total billed" Binding="{Binding Billed, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Total paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Overdue" Binding="{Binding Overdue, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    </Border>
    </ScrollViewer>
</Page>