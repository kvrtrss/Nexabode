<Page x:Class="Nexabode.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Payments">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Payments"
                             Subtitle="Record payments, review history, and correct mistakes." />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="MonthCard" Label="Collected this month" Margin="0,0,12,0" />
            <controls:StatCard x:Name="TodayCard" Label="Collected today" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OutstandingCard" Label="Outstanding" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Record a payment -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ui:Card VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Record a payment" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <TextBlock Text="Tenant" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TenantCombo" DisplayMemberPath="Name" Margin="0,0,0,6"
                                  SelectionChanged="TenantCombo_SelectionChanged" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" Text="Select a tenant to begin." />

                        <TextBlock Text="Payment date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <DatePicker x:Name="PayDatePicker" Margin="0,0,0,10" />
                        <TextBlock Text="Amount received" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="AmountBox" Margin="0,0,0,10" />
                        <TextBlock Text="Method" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="MethodCombo" IsEditable="True" Margin="0,0,0,10">
                            <ComboBoxItem Content="Cash" />
                            <ComboBoxItem Content="GCash" />
                            <ComboBoxItem Content="Bank transfer" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>
                        <ui:TextBox x:Name="ReferenceBox" PlaceholderText="Reference no. (optional)" Margin="0,0,0,10" />
                        <ui:TextBox x:Name="RemarksBox" PlaceholderText="Remarks (optional)" Margin="0,0,0,14" />

                        <TextBlock Text="What is the tenant paying for?" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="PayForCombo" DisplayMemberPath="Display" Margin="0,0,0,6"
          SelectionChanged="PayFor_SelectionChanged" />
                        <TextBlock x:Name="PayForHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <ui:Button Content="Record payment" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Click="RecordPayment_Click" />
                    </StackPanel>
                </ui:Card>
            </ScrollViewer>

            <!-- Tabs -->
            <TabControl x:Name="Tabs" Grid.Column="2">
                <TabItem Header="Payment history">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,12,0"
                                        PlaceholderText="Search tenant, method, or reference"
                                        TextChanged="SearchBox_TextChanged" />
                            <CheckBox x:Name="ShowVoidedCheck" Content="Show voided" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
                            <ui:Button x:Name="EditButton" Content="Edit payment" Click="EditPayment_Click"
                                       IsEnabled="False" Margin="0,0,8,0" />
                            <ui:Button x:Name="VoidButton" Content="Void payment" Click="VoidPayment_Click"
                                       IsEnabled="False" />
                        </StackPanel>

                        <DataGrid x:Name="PaymentGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                  SelectionChanged="PaymentGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="105" />
                                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                        ElementStyle="{StaticResource RightCell}" Width="105" />
                                <DataGridTextColumn Header="Paid for" Binding="{Binding PaidFor}" Width="130" />
                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="100" />
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="150" />
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}"
                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Unpaid charges">
                    <DataGrid x:Name="ChargeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding BillingMonth}" Width="90" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="105" />
                            <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="110" />
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}"
                                                          ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="All balances">
                    <DataGrid x:Name="BalanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                            <DataGridTextColumn Header="Total billed" Binding="{Binding Billed, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Total paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                            <DataGridTextColumn Header="Overdue" Binding="{Binding Overdue, StringFormat='₱{0:N2}'}"
                                                ElementStyle="{StaticResource RightCell}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>