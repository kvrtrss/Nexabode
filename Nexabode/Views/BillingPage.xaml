<Page x:Class="Nexabode.Views.BillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Billing Charges">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Billing Charges"
                             Subtitle="Rent and utility charges for each tenant, by month."
                             ActionText="Generate rent"
                             ActionClick="GenerateRent_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="BilledCard" Label="Billed" Margin="0,0,12,0" />
            <controls:StatCard x:Name="PaidCard" Label="Paid" Margin="0,0,12,0" />
            <controls:StatCard x:Name="BalanceCard" Label="Balance" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <ComboBox x:Name="MonthCombo" Width="190" DisplayMemberPath="Display" Margin="0,0,20,0"
                      SelectionChanged="MonthCombo_SelectionChanged" />
            <TextBlock Text="Rent due date" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <DatePicker x:Name="RentDuePicker" Width="160" Margin="0,0,20,0" />
            <CheckBox x:Name="ProrateCheck" Content="Prorate partial months" Margin="0,0,20,0" />
            <CheckBox x:Name="ShowVoidedCheck" Content="Show voided"
                      Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="EditButton" Content="Edit charge" Click="EditCharge_Click"
                       IsEnabled="False" Margin="0,0,8,0" />
            <ui:Button x:Name="VoidButton" Content="Void charge" Click="VoidCharge_Click"
                       IsEnabled="False" />
        </StackPanel>

        <DataGrid x:Name="ChargeGrid" Grid.Row="4" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="ChargeGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                <DataGridTextColumn Header="Bed" Binding="{Binding Bed}" Width="150" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="170" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="105" />
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Status}"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>