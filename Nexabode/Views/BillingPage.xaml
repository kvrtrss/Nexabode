<Page x:Class="Nexabode.Views.BillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Billing Charges">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Billing Charges"
                             Subtitle="Every charge, who has paid it, and what is still owed." />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="BilledCard" Label="Billed" Margin="0,0,12,0" />
            <controls:StatCard x:Name="PaidCard" Label="Paid" Margin="0,0,12,0" />
            <controls:StatCard x:Name="BalanceCard" Label="Balance" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <ComboBox x:Name="MonthCombo" Width="190" DisplayMemberPath="Display" Margin="0,0,20,0"
                      SelectionChanged="MonthCombo_SelectionChanged" />
            <CheckBox x:Name="ShowVoidedCheck" Content="Show voided"
                      Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
            <CheckBox x:Name="ShowArchivedCheck" Content="Show archived" Margin="16,0,0,0"
          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
        </StackPanel>

        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="ItemFilter" Width="150" Margin="0,0,8,6"
              SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="StatusFilter" Width="160" Margin="0,0,8,6"
              SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All statuses" IsSelected="True" />
                <ComboBoxItem Content="Not fully paid" />
                <ComboBoxItem Content="Fully paid" />
                <ComboBoxItem Content="Overdue" />
                <ComboBoxItem Content="Refunded" />
            </ComboBox>
            <ui:TextBox x:Name="SearchBox" Width="220" Margin="0,0,20,6"
                PlaceholderText="Search by tenant" TextChanged="SearchBox_TextChanged" />
            <ui:Button x:Name="EditButton" Content="Edit charge" Click="EditCharge_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="VoidButton" Content="Void charge" Click="VoidCharge_Click"
               IsEnabled="False" Margin="0,0,20,6" />
            <ui:Button x:Name="ArchiveButton" Content="Archive" Click="Archive_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="UnarchiveButton" Content="Unarchive" Click="Unarchive_Click"
               IsEnabled="False" Margin="0,0,8,6" />
            <ui:Button x:Name="ArchiveSettledButton" Content="Archive all settled"
               Click="ArchiveSettled_Click" Margin="0,0,0,6" />
        </WrapPanel>

        <DataGrid x:Name="ChargeGrid" Grid.Row="4" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                  SelectionChanged="ChargeGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="95" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="140" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="105" />
                <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="100" />
                <DataGridTextColumn Header="Paid on" Binding="{Binding LastPaidText}" Width="100" />
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Status}"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Archived" Binding="{Binding ArchivedText}" Width="80" />
                <DataGridTextColumn Header="Note" Binding="{Binding NoteText}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <ui:Card Grid.Row="5" Margin="0,12,0,0">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Style="{StaticResource MutedText}"
                               Text="Click a charge to see who paid it, when, and how." />

                    <Grid x:Name="DetailBody" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DetailSub" Style="{StaticResource MutedText}" Margin="0,2,0,6" />
                            <ContentPresenter x:Name="DetailBadge" HorizontalAlignment="Left" Margin="0,0,0,8"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                            <StackPanel x:Name="InfoPanel" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Payments on this charge" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,8" />
                            <StackPanel x:Name="PaymentList" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="SummaryTitle" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,8" />
                            <StackPanel x:Name="SummaryPanel" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </ui:Card>
    </Grid>
</Page>