<Window x:Class="Nexabode.Views.TenantDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tenant details" Width="560" SizeToContent="Height" MaxHeight="780" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- The right 14px is kept free for the scroll bar, so it never sits on top of the content. -->
            <StackPanel Margin="0,0,14,0">
                <TextBlock x:Name="DetailName" Style="{StaticResource SectionTitle}" FontSize="20" TextWrapping="Wrap" />
                <ContentPresenter x:Name="DetailBadge" HorizontalAlignment="Left" Margin="0,6,0,12"
                                  ContentTemplate="{StaticResource StatusBadgeTemplate}" />

                <StackPanel x:Name="InfoPanel" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Tenant" Style="{StaticResource GroupLabel}" />
                    <UniformGrid Columns="2" Margin="-3,0,-3,12">
                        <UniformGrid.Resources>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ActionButton}" />
                        </UniformGrid.Resources>
                        <ui:Button x:Name="AccountButton" Content="Tenant account" Click="ViewAccount_Click" />
                        <ui:Button x:Name="EditButton" Content="Edit tenant" Click="EditTenant_Click" />
                        <ui:Button x:Name="HistoryButton" Content="Change history" Click="StayHistory_Click" />
                    </UniformGrid>

                    <TextBlock Text="Stay" Style="{StaticResource GroupLabel}" />
                    <UniformGrid Columns="2" Margin="-3,0,-3,12">
                        <UniformGrid.Resources>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ActionButton}" />
                        </UniformGrid.Resources>
                        <ui:Button x:Name="MoveInButton" Content="Move in" Appearance="Primary" Click="MoveIn_Click" />
                        <ui:Button x:Name="MoveOutButton" Content="Move out" Click="MoveOut_Click" />
                        <ui:Button x:Name="EditStayButton" Content="Edit stay" Click="EditStay_Click" />
                    </UniformGrid>

                    <TextBlock Text="Deposit" Style="{StaticResource GroupLabel}" />
                    <UniformGrid Columns="2" Margin="-3,0,-3,0">
                        <UniformGrid.Resources>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ActionButton}" />
                        </UniformGrid.Resources>
                        <ui:Button x:Name="ApplyDepositButton" Content="Apply deposit" Click="ApplyDeposit_Click" />
                        <ui:Button x:Name="RefundDepositButton" Content="Refund deposit" Click="RefundDeposit_Click" />
                        <ui:Button x:Name="EditDepositButton" Content="Edit deposit" Click="EditDeposit_Click" />
                        <ui:Button x:Name="UndoRefundButton" Content="Undo refund" Click="UndoRefund_Click" />
                    </UniformGrid>
                </StackPanel>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Stay history" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <StackPanel x:Name="HistoryPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ui:Button Grid.Row="1" Content="Close" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,14,0,0" />
    </Grid>
</Window>
