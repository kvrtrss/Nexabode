<Window x:Class="Nexabode.Views.PaymentRecordedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Payment recorded" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,22">
            <TextBlock Text="Payment recorded" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Same command area as the confirmation windows: OK on the left, and on the right the likely next
             step, printing the receipt, in the accent color with a printer icon. -->
        <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="OK" IsDefault="True" IsCancel="True"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="34" />
                <ui:Button x:Name="PrintButton" Grid.Column="2" Content="Print receipt" Appearance="Primary"
                           Click="Print_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           MinHeight="34" ToolTip="Print a receipt for this payment">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Print24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>
