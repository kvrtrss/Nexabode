<Window x:Class="Nexabode.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel x:Name="CurrentPanel">
            <TextBlock Text="Current password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="CurrentBox" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="New password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="NewBox" Margin="0,0,0,12" />

        <TextBlock Text="Confirm new password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="ConfirmBox" Margin="0,0,0,8" />

        <TextBlock Text="At least 8 characters. Write it down somewhere safe: there is no password reset."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Content="Save password" Appearance="Primary" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>