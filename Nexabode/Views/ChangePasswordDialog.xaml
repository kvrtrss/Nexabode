<Window x:Class="Nexabode.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="NoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel x:Name="UsernamePanel" Visibility="Collapsed">
            <TextBlock Text="Username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,4" />
            <TextBlock Text="Choose your own username instead of the default. Use 3 to 32 characters: letters, numbers, dots, dashes and underscores."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
        </StackPanel>

        <StackPanel x:Name="CurrentPanel">
            <TextBlock Text="Current password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="CurrentBox" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="New password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="NewBox" Margin="0,0,0,8" />
        <controls:PasswordStrengthMeter x:Name="StrengthMeter" />

        <TextBlock Text="Confirm new password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="ConfirmBox" Margin="0,0,0,8" />

        <TextBlock Text="Use at least 8 characters. Keep your recovery code in a safe place, because it is needed to reset a forgotten password."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="SaveButton" Content="Save password" Appearance="Primary"
                       IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>