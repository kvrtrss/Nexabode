<Page x:Class="Nexabode.Views.RentBillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Rent Billing">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Rent Billing"
                             Subtitle="Generate and manage monthly rent charges."
                             ActionText="Generate rent"
                             ActionClick="GenerateAll_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="TotalCard" Label="Total rent" Margin="0,0,12,0" />
            <controls:StatCard x:Name="GeneratedCard" Label="Generated" Margin="0,0,12,0" />
            <controls:StatCard x:Name="UnpaidCard" Label="Unpaid" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,8,8"
                   Style="{StaticResource MutedText}" />
                <ComboBox x:Name="MonthCombo" Width="190" DisplayMemberPath="Display" Margin="0,0,20,8"
                  SelectionChanged="MonthCombo_SelectionChanged" />
                <TextBlock Text="Rent due date" VerticalAlignment="Center" Margin="0,0,8,8"
                   Style="{StaticResource MutedText}" />
                <DatePicker x:Name="RentDuePicker" Width="170" Margin="0,0,20,8" />
                <CheckBox x:Name="FullRentCheck" Content="Charge full rent for partial months"
                  VerticalAlignment="Center" Margin="0,0,20,8"
                  ToolTip="By default, a stay that doesn't cover the whole month is billed by days. Tick this to bill the full monthly rent instead."
                  Checked="FullRent_Changed" Unchecked="FullRent_Changed" />
                <CheckBox x:Name="ShowVoidedCheck" Content="Show voided"
                  VerticalAlignment="Center" Margin="0,0,20,8"
                  Checked="ShowVoided_Changed" Unchecked="ShowVoided_Changed" />
                <CheckBox x:Name="ShowArchivedCheck" Content="Show archived"
                  VerticalAlignment="Center" Margin="0,0,0,8"
                  Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed" />
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
                <ui:Button x:Name="GenerateSelectedButton" Content="Generate for selected tenant"
                   IsEnabled="False" Click="GenerateSelected_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="EditRentButton" Content="Edit rent" Click="EditRent_Click"
                   IsEnabled="False" Margin="0,0,32,0"
                   ToolTip="Change the details, due date, or (while nothing is paid) the amount of a generated rent charge." />
                <ui:Button x:Name="ArchiveButton" Content="Archive" Click="Archive_Click"
                   IsEnabled="False" Margin="0,0,8,0" />
                <ui:Button x:Name="UnarchiveButton" Content="Unarchive" Click="Unarchive_Click"
                   IsEnabled="False" Margin="0,0,8,0" />
                <ui:Button x:Name="ArchiveSettledButton" Content="Archive all settled"
                   Click="ArchiveSettled_Click" />
            </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Rent charges" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <DataGrid x:Name="RentGrid" Grid.Row="4" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                  SelectionChanged="RentGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                <DataGridTextColumn Header="Bed" Binding="{Binding Bed}" Width="170" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="190" />
                <DataGridTextColumn Header="Rent" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="120" />
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Status}"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Voided rent charges count as already billed and are not created again. To void a charge, or to see who has paid, open Billing Charges." />
    </Grid>
</Page>