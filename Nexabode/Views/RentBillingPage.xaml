<Page x:Class="Nexabode.Views.RentBillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Nexabode.Controls"
      Title="Rent Billing">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Rent Billing"
                             Subtitle="Generate and manage monthly rent charges."
                             ActionText="Generate rent"
                             ActionClick="GenerateAll_Click" />

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:StatCard x:Name="TotalCard" Label="Total rent" Margin="0,0,12,0" />
            <controls:StatCard x:Name="GeneratedCard" Label="Generated" Margin="0,0,12,0" />
            <controls:StatCard x:Name="UnpaidCard" Label="Unpaid" Margin="0,0,12,0" />
            <controls:StatCard x:Name="OverdueCard" Label="Overdue" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <ComboBox x:Name="MonthCombo" Width="190" DisplayMemberPath="Display" Margin="0,0,20,0"
                      SelectionChanged="MonthCombo_SelectionChanged" />
            <TextBlock Text="Rent due date" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedText}" />
            <DatePicker x:Name="RentDuePicker" Width="170" Margin="0,0,20,0" />
            <CheckBox x:Name="FullRentCheck" Content="Charge full rent for partial months" Margin="0,0,20,0"
          ToolTip="By default, a stay that doesn't cover the whole month is billed by days. Tick this to bill the full monthly rent instead."
          Checked="FullRent_Changed" Unchecked="FullRent_Changed" />
            <ui:Button x:Name="GenerateSelectedButton" Content="Generate for selected tenant"
                       IsEnabled="False" Click="GenerateSelected_Click" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Rent charges" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <DataGrid x:Name="RentGrid" Grid.Row="4" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="RentGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                <DataGridTextColumn Header="Bed" Binding="{Binding Bed}" Width="170" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="190" />
                <DataGridTextColumn Header="Rent" Binding="{Binding Amount, StringFormat='₱{0:N2}'}"
                                    ElementStyle="{StaticResource RightCell}" Width="120" />
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Status}"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Voided rent charges count as already billed and are not created again. To edit or void a charge, or to see who has paid, open Billing Charges." />
    </Grid>
</Page>