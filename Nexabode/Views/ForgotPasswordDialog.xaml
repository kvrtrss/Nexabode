<Window x:Class="Nexabode.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Title="Reset password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="Reset your password" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Enter your username and the recovery code you saved when you set up your account, then choose a new password." />

        <TextBlock Text="Username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,12" AutomationProperties.Name="Username" />

        <TextBlock Text="Recovery code" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="CodeBox" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="24"
                    PlaceholderText="XXXX-XXXX-XXXX-XXXX" Margin="0,0,0,12"
                    AutomationProperties.Name="Recovery code" />

        <TextBlock Text="New password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="NewBox" Margin="0,0,0,8" AutomationProperties.Name="New password" />
        <controls:PasswordStrengthMeter x:Name="StrengthMeter" />

        <TextBlock Text="Confirm new password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="ConfirmBox" Margin="0,0,0,6" AutomationProperties.Name="Confirm new password" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Use at least 8 characters." />

        <Border Style="{StaticResource BannerInfo}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="No recovery code?" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Ask an Owner to reset your password in Settings, under Accounts. If you are the only Owner, close this window and select &quot;Locked out of every account?&quot; on the sign-in screen, then enter your emergency access key or, if you set one, your reset phrase. That creates a new Owner account, which can then reset your password. If you have none of these, Nexabode cannot reset it." />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="For security, an incorrect code counts as a failed sign-in attempt. Three failed attempts in a row lock sign-in temporarily." />

        <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button x:Name="SaveButton" Content="Reset password" Appearance="Primary"
                       FontWeight="SemiBold" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
