<Window x:Class="Nexabode.Views.EmergencyAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Nexabode.Controls"
        Title="Forgot password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="Forgot your password?" Style="{StaticResource SectionTitle}"
                   FontSize="18" Margin="0,0,0,6" />
        <TextBlock x:Name="IntroText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Enter your Owner recovery key, your username and a new password. If an Owner account has that username, its password is replaced. Otherwise a new Owner account is created. Staff: ask an Owner to reset your password in Settings." />

        <TextBlock Text="Owner recovery key" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="KeyBox" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="30"
                    PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX" Margin="0,0,0,12"
                    AutomationProperties.Name="Owner recovery key" />

        <TextBlock Text="Username" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,12" AutomationProperties.Name="Username" />

        <TextBlock Text="New password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="NewBox" Margin="0,0,0,8" AutomationProperties.Name="New password" />
        <controls:PasswordStrengthMeter x:Name="StrengthMeter" />

        <TextBlock Text="Confirm new password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <ui:PasswordBox x:Name="ConfirmBox" Margin="0,0,0,6" AutomationProperties.Name="Confirm new password" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Use at least 8 characters. A wrong key counts as a failed sign-in attempt, and three in a row lock sign-in for a while." />

        <controls:InlineError x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Content="Continue" Appearance="Primary" FontWeight="SemiBold"
                       IsDefault="True" Click="Continue_Click" />
        </StackPanel>
    </StackPanel>
</Window>
