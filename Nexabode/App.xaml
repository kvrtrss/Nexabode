<Application x:Class="Nexabode.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="AppSecondaryBrush" Color="#64748B" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="InfoBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#64748B" />
            <SolidColorBrush x:Key="OccupiedBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2616A34A" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#26D97706" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#26DC2626" />
            <SolidColorBrush x:Key="InfoSoftBrush" Color="#260284C7" />
            <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2664748B" />
            <SolidColorBrush x:Key="OccupiedSoftBrush" Color="#264F46E5" />

            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource AppSecondaryBrush}" />
            </Style>

            <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="RowHeight" Value="40" />
            </Style>

            <!-- Right-aligned cells for money columns -->
            <Style x:Key="RightCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Status badge: always shows a text label, color only supports it -->
            <DataTemplate x:Key="StatusBadgeTemplate">
                <Border x:Name="Pill" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left"
            VerticalAlignment="Center" Background="{DynamicResource NeutralSoftBrush}">
                    <TextBlock x:Name="Label" Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource NeutralBrush}" />
                </Border>
                <DataTemplate.Triggers>
                    <!-- Green: positive -->
                    <DataTrigger Binding="{Binding}" Value="Paid">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Available">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Split">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <!-- Amber: pending -->
                    <DataTrigger Binding="{Binding}" Value="Unpaid">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Partial">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Reserved">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <!-- Red: urgent -->
                    <DataTrigger Binding="{Binding}" Value="Overdue">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Maintenance">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                    <!-- Indigo: occupied -->
                    <DataTrigger Binding="{Binding}" Value="Occupied">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource OccupiedSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OccupiedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Staying">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource OccupiedSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OccupiedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Recorded">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <!-- Anything else (Inactive, Draft, Moved out) stays gray -->
                </DataTemplate.Triggers>
            </DataTemplate>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>