<UserControl x:Class="Nexabode.Controls.InlineError"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The error message shown inside a dialog: a red banner, like the ones on the sign-in screen. -->
    <Border Style="{StaticResource BannerDanger}">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextBrush}"
                   AutomationProperties.LiveSetting="Assertive" />
    </Border>
</UserControl>
